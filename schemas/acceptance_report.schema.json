{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "decision": {
      "additionalProperties": false,
      "properties": {
        "reasons": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "status": {
          "type": "string"
        }
      },
      "required": [
        "status",
        "reasons"
      ],
      "type": "object"
    },
    "evidence": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "name": {
            "minLength": 1,
            "type": "string"
          },
          "path": {
            "minLength": 1,
            "type": "string"
          },
          "sha256": {
            "pattern": "^[a-f0-9]{64}$",
            "type": "string"
          }
        },
        "required": [
          "name",
          "path",
          "sha256"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "expected_status": {
      "type": "string"
    },
    "passed": {
      "type": "boolean"
    },
    "release_stage": {
      "enum": [
        "pipeline_smoke",
        "learning_candidate",
        "candidate",
        "production_model"
      ]
    },
    "schema_version": {
      "const": "1.0"
    },
    "violations": {
      "items": {
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "release_stage",
    "decision",
    "expected_status",
    "violations",
    "evidence",
    "passed"
  ],
  "type": "object"
}
